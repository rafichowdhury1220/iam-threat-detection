# Environment configuration
# Copy this to .env and fill in appropriate values

# Application
APP_NAME="IAM Threat Detection System"
DEBUG=true
ENVIRONMENT=development

# API
API_TITLE="IAM Threat Detection API"
API_VERSION=1.0.0

# Database
DATABASE_URL="postgresql://iam_user:secure_password@localhost:5432/iam_threat_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Security
SECRET_KEY="change-this-in-production-use-secure-random-key"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT
JWT_AUDIENCE="iam-threat-detection"
JWT_ISSUER="iam-threat-detection"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=true

# Threat Detection
IMPOSSIBLE_TRAVEL_THRESHOLD_KM=1000
IMPOSSIBLE_TRAVEL_TIME_THRESHOLD_MINUTES=15
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MINUTES=15
PRIVILEGE_ESCALATION_ALERT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/iam_threat_detection.log

# Features
ENABLE_MFA=true
ENABLE_AUDIT_LOGGING=true
ENABLE_THREAT_DETECTION=true
ENABLE_METRICS=true

# GeoIP
GEOIP_DATABASE_PATH=/opt/geoip/GeoLite2-City.mmdb
