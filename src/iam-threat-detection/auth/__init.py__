"""Authentication and authorization services"""

from datetime import datetime, timedelta
from typing import Optional, Tuple
from uuid import UUID

import pytz
from passlib.context import CryptContext
from python_jose import JWTError, jwt

from ..core.config import settings
from ..core.logger import get_logger

logger = get_logger(__name__)

# Password hashing
pwd_context = CryptContext(
    schemes=["bcrypt"],
    deprecated="auto",
    bcrypt__rounds=12,
)


class AuthService:
    """Handles authentication, tokens, and security"""

    @staticmethod
    def hash_password(password: str) -> str:
        """Hash a password securely"""
        return pwd_context.hash(password)

    @staticmethod
    def verify_password(plain_password: str, hashed_password: str) -> bool:
        """Verify a password against its hash"""
        return pwd_context.verify(plain_password, hashed_password)

    @staticmethod
    def create_access_token(
        user_id: UUID,
        role: str,
        email: str,
        expires_delta: Optional[timedelta] = None,
    ) -> Tuple[str, datetime]:
        """Create JWT access token"""
        if expires_delta is None:
            expires_delta = timedelta(
                minutes=settings.access_token_expire_minutes
            )

        expire = datetime.utcnow() + expires_delta
        to_encode = {
            "sub": str(user_id),
            "email": email,
            "role": role,
            "iat": datetime.utcnow(),
            "exp": expire,
            "aud": settings.jwt_audience,
            "iss": settings.jwt_issuer,
        }

        encoded_jwt = jwt.encode(
            to_encode,
            settings.secret_key,
            algorithm=settings.algorithm,
        )
        return encoded_jwt, expire

    @staticmethod
    def create_refresh_token(user_id: UUID) -> Tuple[str, datetime]:
        """Create JWT refresh token"""
        expires_delta = timedelta(days=settings.refresh_token_expire_days)
        expire = datetime.utcnow() + expires_delta
        to_encode = {
            "sub": str(user_id),
            "type": "refresh",
            "iat": datetime.utcnow(),
            "exp": expire,
            "aud": settings.jwt_audience,
        }

        encoded_jwt = jwt.encode(
            to_encode,
            settings.secret_key,
            algorithm=settings.algorithm,
        )
        return encoded_jwt, expire

    @staticmethod
    def verify_token(token: str) -> Optional[dict]:
        """Verify and decode JWT token"""
        try:
            payload = jwt.decode(
                token,
                settings.secret_key,
                algorithms=[settings.algorithm],
                audience=settings.jwt_audience,
            )
            return payload
        except JWTError as e:
            logger.warning("Token verification failed", error=str(e))
            return None

    @staticmethod
    def extract_user_id_from_token(token: str) -> Optional[UUID]:
        """Extract user ID from token"""
        payload = AuthService.verify_token(token)
        if payload:
            try:
                return UUID(payload.get("sub"))
            except (ValueError, TypeError):
                return None
        return None


class RBACService:
    """Role-Based Access Control"""

    ROLE_HIERARCHY = {
        "admin": 100,
        "security_officer": 80,
        "manager": 50,
        "user": 20,
        "guest": 10,
    }

    # Permission matrix
    ROLE_PERMISSIONS = {
        "admin": {
            "users:create", "users:read", "users:update", "users:delete",
            "roles:assign", "roles:revoke", "policies:manage",
            "alerts:view", "alerts:acknowledge", "audit:view",
            "mfa:enforce", "mfa:disable", "system:configure",
        },
        "security_officer": {
            "users:read", "alerts:view", "alerts:acknowledge",
            "audit:view", "mfa:enforce", "policies:view",
        },
        "manager": {
            "users:read", "alerts:view", "audit:view",
        },
        "user": {
            "users:read:self", "alerts:view:self", "audit:view:self",
        },
        "guest": {
            "system:status",
        },
    }

    @classmethod
    def has_permission(cls, role: str, permission: str) -> bool:
        """Check if role has specific permission"""
        permissions = cls.ROLE_PERMISSIONS.get(role, set())
        return permission in permissions

    @classmethod
    def can_escalate_to_role(
        cls, current_role: str, target_role: str
    ) -> bool:
        """Check if current role can escalate to target role"""
        current_level = cls.ROLE_HIERARCHY.get(current_role, 0)
        target_level = cls.ROLE_HIERARCHY.get(target_role, 0)
        return current_level > target_level

    @classmethod
    def get_role_level(cls, role: str) -> int:
        """Get numeric role level"""
        return cls.ROLE_HIERARCHY.get(role, 0)


class MFAService:
    """Multi-Factor Authentication service"""

    @staticmethod
    def generate_secret() -> str:
        """Generate TOTP secret for MFA"""
        import pyotp
        return pyotp.random_base32()

    @staticmethod
    def generate_backup_codes(count: int = 10) -> list[str]:
        """Generate backup codes"""
        import secrets
        return [secrets.token_urlsafe(8) for _ in range(count)]

    @staticmethod
    def verify_totp(secret: str, code: str) -> bool:
        """Verify TOTP code"""
        import pyotp
        totp = pyotp.TOTP(secret)
        # Allow ±1 window for time drift
        return totp.verify(code, valid_window=1)

    @staticmethod
    def get_provisioning_uri(email: str, secret: str) -> str:
        """Get provisioning URI for QR code generation"""
        import pyotp
        totp = pyotp.TOTP(secret)
        return totp.provisioning_uri(
            name=email,
            issuer_name=settings.app_name,
        )
